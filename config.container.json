{
  "dataDir": "/app/data",
  "dbPath": "/app/data/db/audit.db",
  "agents": {},
  "ingest": {
    "http": {
      "enabled": true,
      "maxBodyBytes": 1048576,
      "maxLineBytes": 65536
    },
    "spoolDir": "/app/data/spool/incoming"
  },
  "capturesDir": "/app/data/captures",
  "tmpDir": "/app/data/tmp",
  "logDir": "/app/data/logs",
  "limits": {
    "maxLineBytes": 65536,
    "maxChunkBytes": 16777216,
    "maxQueryLimit": 1000,
    "maxBodyBytes": 1048576
  },
  "report": {
    "timezoneOffsetMinutes": 480
  },
  "retention": {
    "enabled": true,
    "runAtHour": 4,
    "traceDays": 30,
    "highRiskTraceDays": 90,
    "maxTracesPerAgent": 2000,
    "runtimeRunsDays": 30,
    "waitingStatesDays": 30,
    "llmUsageDays": 90,
    "outboxDays": 14,
    "logFilesDays": 14,
    "tmpFilesDays": 7,
    "captureFilesDays": 30,
    "vacuum": "incremental"
  },
  "auditReview": {
    "enabled": true,
    "intervalMinutes": 30,
    "initialDelaySeconds": 30,
    "lookbackOverlapMinutes": 5,
    "maxEventsPerReview": 500,
    "traceReview": {
      "idleTimeoutMinutes": 60,
      "waitingUserTimeoutMinutes": 1440,
      "maxEventsPerTrace": 2000,
      "maxInvalidOutputRetries": 2
    },
    "notification": {
      "enabled": true,
      "mode": "feishu_bot",
      "feishuMode": "disabled",
      "minSeverity": "high",
      "sendEmptyReview": false,
      "maxAttempts": 8,
      "card": {
        "maxPayloadBytes": 19456,
        "foldThresholdChars": 800
      },
      "dailyReport": {
        "enabled": true,
        "hours": [10, 17],
        "timezoneOffsetMinutes": 480,
        "catchUpWindowMinutes": 30
      }
    },
    "http": {
      "bindHost": "0.0.0.0",
      "requireDashboardToken": false,
      "requireHttpsBaseUrl": true,
      "allowedOrigins": []
    },
    "riskPolicy": {
      "version": "risk-policy-v2",
      "repeatWindowMinutes": 10,
      "repeatThreshold": 5,
      "slowCallDurationMs": 30000,
      "traceToolChainStepThreshold": 50,
      "highRiskToolPatterns": [
        "*delete*",
        "*write*",
        "*update*",
        "*deploy*",
        "*permission*",
        "*credential*",
        "shell.*",
        "browser.runScript"
      ],
      "highRiskMappedToolTypes": [
        "write",
        "update",
        "delete",
        "deploy",
        "permission",
        "credential",
        "shell"
      ],
      "agentToolAllowlists": {
        "rental-price-agent": [],
        "mt-agent": []
      }
    },
    "toolMapping": {
      "version": "tool-semantic-mapping-v1",
      "taxonomy": [
        "read",
        "write",
        "update",
        "delete",
        "deploy",
        "permission",
        "credential",
        "shell",
        "browser",
        "network",
        "database",
        "file",
        "notification",
        "llm",
        "unknown"
      ]
    },
    "llmReview": {
      "promptVersion": "audit-review-prompt-v1",
      "reviewerVersion": "audit-reviewer-v1",
      "maxCandidatesPerCall": 12
    },
    "llmBudget": {
      "maxCallsPerDay": 500,
      "maxTokensPerDay": 2000000,
      "maxConcurrency": 2,
      "cacheDetailAnalysis": true
    },
    "visualization": {
      "enabled": true,
      "baseUrl": "",
      "dashboardPath": "/dashboard",
      "template": "audit-review-dashboard-v1",
      "attachDashboardUrlToFeishu": true
    }
  }
}
